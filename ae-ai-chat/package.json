    "check": "tsc --noEmit",
    "test": "node test/host.test.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.14.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "private": true,
  "type": "module"
}
