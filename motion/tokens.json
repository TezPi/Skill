{
  "$description": "Single source of truth for every film. Edit here, then `npm run tokens` (emits motion/dist/tokens.{css,js} and remotion/src/motion/tokens.generated.ts) and `npm run film:sync` (copies into each film's vendor/). Motion numbers are the tezpi-motion doctrine verbatim; brand values are placeholders until a real brand is supplied.",
  "canvas": {
    "width": 1920,
    "height": 1080,
    "fps": 30
  },
  "color": {
    "$description": "Placeholder house palette (60-30-10: canvas / surface+ink / accent). WCAG (measured): ink/canvas 18.0:1, ink/surface 16.5:1, inkMuted/canvas 7.7:1, accent/canvas 6.0:1, accentInk/accent 6.0:1, ink/accentStrong 4.4:1 (large text), accentStrong/surface 3.7:1 (UI). Filled buttons use accentStrong + ink so seam fades toward the dark canvas only raise contrast.",
    "canvas": "#0B0B10",
    "canvasDeep": "#060609",
    "surface": "#16161F",
    "surfaceLine": "#2A2A36",
    "ink": "#F5F5F7",
    "inkMuted": "#A1A1AE",
    "accent": "#8B7BFF",
    "accentInk": "#0B0B10",
    "accentStrong": "#6D5AF0"
  },
  "font": {
    "sans": {
      "family": "Inter Variable",
      "file": "inter-latin-wght-normal.woff2",
      "weight": "100 900",
      "fallback": "ui-sans-serif, system-ui, sans-serif"
    }
  },
  "type": {
    "$description": "px at 1920x1080. Max two weights per scene.",
    "display": { "size": 168, "weight": 720, "tracking": -0.045, "leading": 0.92 },
    "headline": { "size": 104, "weight": 680, "tracking": -0.035, "leading": 0.98 },
    "title": { "size": 64, "weight": 620, "tracking": -0.02, "leading": 1.05 },
    "body": { "size": 36, "weight": 450, "tracking": -0.01, "leading": 1.35 },
    "label": { "size": 24, "weight": 560, "tracking": 0.06, "leading": 1.2 }
  },
  "radius": {
    "card": 28,
    "pill": 999
  },
  "motion": {
    "current": "left",
    "ease": {
      "$description": "GSAP names. Remotion mapping lives in remotion/src/motion/eases.ts (motion-forge §6 Rosetta). bounce.out / elastic.out are banned.",
      "seamExit": "power4.in",
      "seamEntry": "power4.out",
      "seamFade": "power2.in",
      "zoomExit": "power3.in",
      "zoomEntry": "expo.out",
      "rackExit": "power2.in",
      "rackEntry": "power2.out",
      "arrival": "power4.out",
      "nudgeRamp": "power3.in",
      "nudgeBurst": "none",
      "nudgeTail": "power4.out",
      "cursorEnter": "power3.out",
      "cursorExit": "power2.in",
      "cursorDrift": "power2.out",
      "pressIn": "power2.in",
      "pressOut": "power2.out",
      "overshoot": "back.out(1.6)"
    },
    "duration": {
      "$description": "Seconds.",
      "entryMax": 0.8,
      "staggerTotalMax": 0.5,
      "cutTheCurve": { "exit": 0.34, "entry": 0.42, "fade": 0.18 },
      "zoom": { "exit": 0.2, "entry": 0.5 },
      "inverseZoom": { "exit": 0.21, "entry": 0.5 },
      "waterfallCut": { "exit": 0.34, "fade": 0.18, "exitStagger": 0.022, "entry": 0.3, "entryGap": 0.05, "gapDecay": 0.84 },
      "rackFocus": { "exit": 0.3, "entry": 0.35, "minSpacing": 8 },
      "arrival": { "heavy": 0.18, "normal": 0.15, "light": 0.12 },
      "stillness": { "min": 0.3, "max": 0.75 },
      "press": { "in": 0.1, "out": 0.22 },
      "cursorEnter": 0.85,
      "cursorExit": 0.6,
      "cursorDrift": 0.7
    },
    "distance": {
      "travelFraction": 0.12,
      "arrival": { "heavy": 70, "normal": 45, "light": 36 }
    },
    "blur": {
      "text": 10,
      "surface": 18,
      "cutTheCurve": 8,
      "rackPeak": 12
    },
    "scale": {
      "push": { "exit": 1.2, "entry": 0.75 },
      "pull": { "exit": 0.8, "entry": 1.25 },
      "press": 0.84,
      "targetPress": 0.94,
      "rackBreath": 1.06
    },
    "opacity": {
      "seamIgnite": 0.35,
      "zoomFloor": 0.15
    },
    "nudge": {
      "$description": "Cumulative fractions for the three chained tweens (ramp / burst / tail). Tail time must be >= 3x ramp time.",
      "distance": [0.11, 0.78, 1],
      "time": [0.21, 0.39, 1]
    },
    "cursor": {
      "size": "7cqw",
      "sizeInMock": "5cqw",
      "tipOrigin": "21% 14%"
    }
  }
}
